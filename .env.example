# Copy this file to .env and fill in your keys.  NEVER share .env.

# Free key from https://aistudio.google.com/apikey  (separate from the Gemini app subscription)
GEMINI_API_KEY=

# Free key from https://www.pexels.com/api/  (licensed stock video)
PEXELS_API_KEY=

# Optional, free: YouTube Data API key (Google Cloud console -> APIs -> YouTube Data API v3 -> Credentials -> API key)
# Lets the Creator Intelligence agents read public stats of the top channels you list in config.yaml
YOUTUBE_API_KEY=
